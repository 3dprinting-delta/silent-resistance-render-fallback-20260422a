generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String?       @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  accounts      Account[]
  sessions      Session[]
  gameProfile   GameProfile?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model GameProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  displayName       String
  settingsJson      String   @default("{}")
  selectedLoadout   String   @default("[]")
  unlockedCosmetics String   @default("[]")
  recentMatchesJson String   @default("[]")
  challengeCompletionsJson String @default("[]")
  bannersJson       String   @default("[]")
  titlesJson        String   @default("[]")
  cosmeticTagsJson  String   @default("[]")
  inventoryJson     String   @default("[]")
  matchesPlayed     Int      @default(0)
  wins              Int      @default(0)
  losses            Int      @default(0)
  level             Int      @default(1)
  xp                Int      @default(0)
  injuryCount       Int      @default(0)
  deaths            Int      @default(0)
  shotsFired        Int      @default(0)
  shotsHit          Int      @default(0)
  survivalTime      Int      @default(0)
  bestSurvivalTime  Int      @default(0)
  mostCommonCauseOfDeath String?
  treatmentsUsed    Int      @default(0)
  successfulStabilizations Int @default(0)
  criticalInjuriesSurvived Int @default(0)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum PortalSection {
  CLASS_INDEX
  GHOST_PROTOCOL
}

enum AccessRequestStatus {
  PENDING
  APPROVED
}

model PortalEntry {
  id         String        @id @default(cuid())
  section    PortalSection
  category   String
  title      String
  url        String
  status     String
  description String?
  createdBy  String?
  sortOrder  Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([section, category, sortOrder, createdAt])
}

model FailedLoginAttempt {
  id                String   @id @default(cuid())
  ipAddress         String
  attemptedUsername String?
  alertSentAt       DateTime?
  createdAt         DateTime @default(now())

  @@index([ipAddress, createdAt])
  @@index([createdAt])
}

model AccessRequest {
  id              String                  @id @default(cuid())
  requesterName   String
  requesterEmail  String
  deviceLabel     String
  claimedIpAddress String
  requestPrompt   String
  status          AccessRequestStatus     @default(PENDING)
  approvedBy      String?
  approvedAt      DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  credential      TemporaryAccessCredential?

  @@index([status, createdAt])
}

model TemporaryAccessCredential {
  id              String      @id @default(cuid())
  requestId       String      @unique
  username        String      @unique
  passwordHash    String
  createdBy       String
  createdAt       DateTime    @default(now())
  consumedAt      DateTime?
  accessExpiresAt DateTime?
  request         AccessRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([username])
  @@index([consumedAt, accessExpiresAt])
}
